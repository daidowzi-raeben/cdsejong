			<div id="messageBox_bg"></div>
		</div>
	</div>
</body>
</html>

<script>
	// 전역 변수 설정
	let currentPage = 1;        // 현재 페이지 번호
	const totalPages = 5;       // 전체 페이지 수
	let bgm;                    // 배경음악 변수

	/**
	 * 페이지 인디케이터 초기화 함수
	 * - 페이지 수만큼 하단에 동그란 인디케이터를 생성
	 * - 첫 페이지의 인디케이터를 활성화 상태로 설정
	 */
	function initializePageIndicators() {
		const indicatorContainer = document.getElementById('pageIndicator');
		// 5개의 페이지 인디케이터 생성
		for (let i = 1; i <= totalPages; i++) {
			const indicator = document.createElement('div');
			// 첫 페이지는 active 클래스 추가				
			indicator.className = 'indicator-box' + (i === 1 ? ' active' : '');
			indicatorContainer.appendChild(indicator);
		}
	}

	/**
	 * 이미지 파일명 생성 함수
	 * @param {number} pageNum - 페이지 번호
	 * @returns {string} - 형식에 맞는 이미지 파일 경로
	 * - 페이지 번호를 3자리 숫자로 변환 (예: 1 → 001)
	 */
	function getImageFileName(pageNum) {
		// 페이지 번호를 001, 002, 003, 004, 005 형식으로 변환
		return `img/${String(pageNum).padStart(3, '0')}.png`;
	}
	
	// 페이지 업데이트 함수
	function updatePage() {
		const image = document.getElementById('currentImage');
		// 현재 페이지에 해당하는 이미지 즉시 로드 (애니메이션 없음)
		image.src = getImageFileName(currentPage);
		
		// 페이지 인디케이터 상태 즉시 업데이트 (애니메이션 없음)
		const indicators = document.querySelectorAll('.indicator-box');
		indicators.forEach((indicator, index) => {
			indicator.className = 'indicator-box' + (index + 1 === currentPage ? ' active' : '');
		});
	}

	/**
	 * 다음 페이지 이동 함수
	 * - 마지막 페이지가 아닐 경우 다음 페이지로 애니메이션과 함께 전환
	 * - 마지막 페이지일 경우 종료 확인 대화상자 표시
	 */
	function nextPage() {
		if (currentPage < totalPages) {
			currentPage++;
			updatePage();
		} else {
			if (confirm("마지막 창입니다. 창을 닫으시겠습니까?")) {


				const page = 3;
				const lesson = 33;
				const chapter = 58;
				const contents = 53;

				var datas = "isEnd=true&lesson=" + lesson + "&chapter=" + chapter + "&contents=" + contents;
				
				if( page == "end" ) datas = datas + "&page=end";
				else  datas = datas + "&page=" + page;
				//else  datas = datas + "&page=" + (page-1); 
				
				
				$.ajax({
					type: "POST",
					url: "/Edu/contents_wbt_check_json.php",
					data: datas,
					success: function(res){
							res_data = jQuery.parseJSON(res);
							if( res_data.res == true ) {
								//alert( res_data.cc + '/' + res_data.ca );
								//alert( res_data.msg );
							} else if( res_data.res == false )  {
								alert( res_data.msg );
							} else {
								alert( res );
							}

										if (bgm) {
					bgm.pause();  // 음악 정지
					bgm.currentTime = 0;  // 음악 위치 초기화
				}
				parent.location.reload();
					},
					error: function(err){}
				});
				if (bgm) {
					bgm.pause();  // 음악 정지
					bgm.currentTime = 0;  // 음악 위치 초기화
				}
				location.reload();
			}
		}
	}

	/**
	 * 이전 페이지 이동 함수
	 * - 첫 페이지가 아닐 경우 이전 페이지로 애니메이션과 함께 전환
	 */
	function prevPage() {
		if (currentPage > 1) {
			currentPage--;
			updatePage();
		}
	}

	// 페이지 로드 완료 시 인디케이터 초기화
	window.onload = function() {
		initializePageIndicators();
		// 애니메이션 효과 제거를 위해 transition 속성 제거
		const container = document.getElementById('imageContainer');
		container.style.transition = 'none';  // 애니메이션 효과 제거

		// 배경음악 초기화 및 재생
		bgm = new Audio('../common/sound/bgm.mp3');
		bgm.loop = true;  // 반복 재생 설정
		bgm.volume = 0.5;  // 볼륨 설정 (0.0 ~ 1.0)
		
		// 사용자 상호작용 후 자동 재생을 위한 이벤트 리스너
		document.addEventListener('click', function initAudio() {
			bgm.play();
			document.removeEventListener('click', initAudio);
		}, { once: true });
	};
</script>